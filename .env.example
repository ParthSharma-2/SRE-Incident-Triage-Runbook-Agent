# DevOps SRE Incident Triage & Runbook Agent Configuration
# Copy to `.env` or export in your shell. Zero proprietary LLM API keys required.

# --- Open-Source LLM Provider ---
# Options: ollama | openai_compatible | deterministic
SRE_AGENT_LLM_PROVIDER=ollama

# Ollama default: http://localhost:11434
# Self-hosted OpenAI-compatible (vLLM / llama.cpp / LocalAI / LM Studio): http://localhost:8000
SRE_AGENT_LLM_BASE_URL=http://localhost:11434

# Open-source model identifier (e.g., llama3.1:8b, qwen2.5:7b, mistral:7b)
SRE_AGENT_LLM_MODEL=llama3.1:8b

# Optional bearer token if your self-hosted OpenAI-compatible server enforces auth
SRE_AGENT_LLM_API_KEY=

# Request timeout in seconds (> 0)
SRE_AGENT_LLM_TIMEOUT_SECONDS=30.0

# Fall back to the deterministic runbook engine if the local LLM endpoint is unreachable
SRE_AGENT_LLM_ALLOW_FALLBACK=true

# --- Live Ingestion Sources (optional; CLI flags override these) ---
# Prometheus (/api/v1/alerts) or Alertmanager (/api/v2/alerts) URL
SRE_AGENT_PROMETHEUS_URL=

# Options: auto | prometheus | alertmanager
SRE_AGENT_ALERT_API_TYPE=auto

# Path to a live application or system log file
SRE_AGENT_LOG_FILE=

# Optional tail limit (positive integer) for live log files
SRE_AGENT_TAIL_LINES=

# Include resolved alerts alongside firing/pending alerts
SRE_AGENT_INCLUDE_RESOLVED=false

# --- Audit & Operator Identity ---
SRE_AGENT_AUDIT_LOG_PATH=./audit_log.jsonl
SRE_AGENT_OPERATOR=sre-operator
